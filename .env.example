# Server Configuration
PORT=3001
NODE_ENV=development

# Groq AI Configuration (Optional - platform operates with 100% deterministic fallback if unset)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Branding (Configurable for CoveIQ Kashmir)
VITE_APP_BRAND_NAME=COVEQUIZ
VITE_APP_SUB_BRAND=CoveIQ Kashmir
